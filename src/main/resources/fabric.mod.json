{
	"schemaVersion": 1,
	"id": "${id}",
	"version": "${version}",
	"name": "${name}",
	"description": "${description}",
	"authors": [
		"${author}"
	],
	"contact": {
		"homepage": "${sources}",
		"sources": "${sources}",
		"issues": "${sources}/issues"
	},
	"license": "Polyform-Shield-1.0.0",
	"icon": "assets/${id}/icon.png",
	"environment": "${environment}",
	"entrypoints": {
		"client": [
			"dev.vinterus.vanillaexplained.client.loader.FabricEntry"
		]
	},
	"mixins": [
		{
			"config": "${id}.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=${fabric_loader}",
		"minecraft": "${minecraft}",
		"java": ">=${java_version}",
		"fabric-api": "*"
	}
}